{
  "name": "landscape",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted macOS-style web desktop for your homeserver.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "Shared",
    "Server",
    "Client",
    "Scripts"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w Server",
    "dev:client": "npm run dev -w Client",
    "build": "npm run wallpapers && npm run build -w Server && npm run build -w Client && npm run build -w Scripts",
    "wallpapers": "npm run wallpapers -w Scripts",
    "seed": "npm run seed -w Scripts",
    "hash-password": "npm run hash-password -w Scripts --",
    "typecheck": "tsc -p Shared && tsc -p Server && tsc -p Client && tsc -p Scripts && tsc -p Tests",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "node --disable-warning=ExperimentalWarning Server/dist/Main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
