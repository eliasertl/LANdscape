{
  "name": "@landscape/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LANdscape backend: auth, persistence, metrics, SSH/SFTP, Docker.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../Scratch/.env src/Main.ts",
    "build": "esbuild src/Main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@landscape/shared=../Shared/src/index.ts --sourcemap --outfile=dist/Main.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@landscape/shared": "*",
    "bcryptjs": "^3.0.3",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.7",
    "ssh2": "^1.17.0",
    "undici": "^8.12.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
